Background)\n            basic.showIcon(IconNames.No)\n        })\n    }\n}\n","pxt.json":"{\n    \"name\": \"gesture-extension\",\n    \"description\": \"\",\n    \"dependencies\": {\n        \"core\": \"*\",\n        \"radio\": \"*\",\n        \"microphone\": \"*\"\n    },\n    \"files\": [\n        \"main.blocks\",\n        \"main.ts\",\n        \"README.md\",\n        \"custom.ts\"\n    ],\n    \"preferredEditor\": \"blocksprj\"\n}\n"}}],"shares":[{"id":"17610-01598-16539-54982","timestamp":1786744583626},{"id":"95668-09581-69297-76431","timestamp":1786746840140},{"id":"00165-38033-08460-39084","timestamp":1786747295238},{"id":"84881-82202-94262-34180","timestamp":1786747576912},{"id":"75476-54562-70485-88106","timestamp":1786748884160},{"id":"25081-72853-59228-68511","timestamp":1786748896603},{"id":"60087-64132-04986-02857","timestamp":1786748916918}],"lastSaveTime":1786749203226}