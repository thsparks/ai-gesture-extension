SLIDER\">200</field></shadow></value><value name=\"duration\"><shadow type=\"math_number_minmax\"><mutation min=\"1\" max=\"9999\" label=\"Duration\" precision=\"0\"></mutation><field name=\"SLIDER\">75</field></shadow></value><value name=\"startVolume\"><shadow type=\"math_number_minmax\"><mutation min=\"0\" max=\"255\" label=\"StartVolume\" precision=\"0\"></mutation><field name=\"SLIDER\">255</field></shadow></value><value name=\"endVolume\"><shadow type=\"math_number_minmax\"><mutation min=\"0\" max=\"255\" label=\"EndVolume\" precision=\"0\"></mutation><field name=\"SLIDER\">0</field></shadow></value></block></value><next><block type=\"variables_set\"><field name=\"VAR\" id=\"%_Br;Rj,Ro?ijCB0Ezf2\">sending_data</field><value name=\"VALUE\"><shadow type=\"math_number\"><field name=\"NUM\">0</field></shadow><block type=\"logic_boolean\"><field name=\"BOOL\">FALSE</field></block></value></block></next></block></next></block></next></block></statement></block></statement></block></xml>","main.ts":"let sending_data = false\n// on ML \"punch\" start\ninput.onLogoEvent(TouchButtonEvent.LongPressed, function () {\n    if (sending_data) {\n        basic.showIcon(IconNames.StickFigure)\n        radio.sendString(\"punch\")\n        music.play(music.createSoundExpression(WaveShape.Triangle, 300, 200, 255, 0, 75, SoundExpressionEffect.None, InterpolationCurve.Curve), music.PlaybackMode.InBackground)\n        sending_data = false\n    }\n})\ninput.onButtonPressed(Button.A, function () {\n    sending_data = true\n    basic.showIcon(IconNames.Yes)\n    music.play(music.stringPlayable(\"C C - C C - C C \", 120), music.PlaybackMode.UntilDone)\n    music.play(music.stringPlayable(\"C5 C5 C5 C5 C5 C5 C5 C5 \", 120), music.PlaybackMode.InBackground)\n})\n// on ML \"kick\" start\ninput.onButtonPressed(Button.AB, function () {\n    if (sending_data) {\n        basic.showIcon(IconNames.Rollerskate)\n        radio.sendString(\"kick\")\n        music.play(music.createSoundExpression(WaveShape.Square, 200, 1, 255, 0, 100, SoundExpressionEffect.None, InterpolationCurve.Curve), music.PlaybackMode.InBackground)\n    }\n})\ninput.onButtonPressed(Button.B, function () {\n    sending_data = false\n})\n// on ML \"still\" start\ninput.onGesture(Gesture.Shake, function () {\n    basic.showIcon(IconNames.SmallSquare)\n})\n// on ML \"throw\" start\ninput.onLogoEvent(TouchButtonEvent.Pressed, function () {\n    if (sending_data) {\n        basic.showIcon(IconNames.SmallDiamond)\n        radio.sendString(\"throw\")\n        music.play(music.createSoundExpression(WaveShape.Sine, 5000, 0, 255, 0, 500, SoundExpressionEffect.None, InterpolationCurve.Linear), music.PlaybackMode.InBackground)\n    }\n})\n","README.md":"","custom.ts":"\n/**\n * Custom blocks\n */\n//% weight=100 color=#0fbc11 icon=\"\" name = \"Gestures!\"\nnamespace gesture_palooza {\n    let sending_data = false;\n\n    /**\n     * Indicate that a gesture was performed\n     * @param gesture The gesture that was performed\n     * @param icon The icon to show on your microbit\n     * @param sound The sound to play\n     */\n    //% block\n    export function send_gesture(gesture: string, icon: IconNames, sound: music.Playable): void {\n        if (sending_data) {\n            radio.sendString(gesture)\n            basic.showIcon(icon)\n            music.play(sound, music.PlaybackMode.InBackground)\n        } else {\n            basic.showIcon(IconNames.No)\n        }\n    }\n\n    /**\n     * Begin sending data to the reciever\n     */\n    //% block\n    export function start_sending_data() {\n        music.play(music.stringPlayable(\"C C - C C - C C \", 120), music.PlaybackMode.UntilDone)\n        music.play(music.stringPlayable(\"C5 C5 C5 C5 C5 C5 C5 C5 \", 120), music.PlaybackMode.InBackground)\n        sending_data = true;\n        control.inBackground(function() { \n            pauseUntil(() => false, 60 * 1000)\n            sending_data = false;\n            basic.showIcon(IconNames.No)\n    